  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "ffmpeg-static": "^5.2.0",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
